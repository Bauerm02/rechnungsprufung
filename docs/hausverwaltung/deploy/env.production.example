# Vorlage für die Produktionsumgebung (HV-20260912-ECHTBETRIEB).
# NIEMALS mit echten Werten in Git committen - diese Datei ist nur die
# Vorlage/Struktur. Die echte Datei lebt AUSSERHALB dieses Repos (z. B.
# /etc/mietinkasso-hausverwaltung/env, von systemd per EnvironmentFile
# geladen) und wird von Codex auf dem bestehenden Hetzner-Server angelegt.
#
# Die Domain (z. B. verwaltung.jlb-immo.at) und der öffentliche Zugang
# werden NICHT hier konfiguriert, sondern von Caddy (Reverse Proxy vor
# dem Unix-Domain-Socket dieses Prozesses) - siehe
# DEPLOYMENT_HETZNER.md und mietinkasso-hausverwaltung.service.example.
# Eigener Login, keine Unterroute des bestehenden CEO-Cockpits.

# -- Datenbank ---------------------------------------------------------
# Persistente Datei-SQLite ODER PostgreSQL - AUSSERHALB des Repos/der
# Codebasis, NICHT die Demo-Datei aus scripts/seed_synthetic_data.py.
MIETINKASSO_DATABASE_URL=sqlite:////var/lib/mietinkasso-hausverwaltung/produktiv.db
# Alternativ: MIETINKASSO_DATABASE_URL=postgresql://user:pass@localhost/mietinkasso

MIETINKASSO_ENVIRONMENT=production

# -- Backoffice-Login (EIN Operator, siehe RAHMENPROGRAMM.md) -----------
MIETINKASSO_BACKOFFICE_USER=markus
# Erzeugen mit: python -m mietinkasso.backoffice.security "<echtes Passwort>"
# NIE das Klartext-Passwort hier ablegen, nur den Hash.
MIETINKASSO_BACKOFFICE_PASSWORD_HASH=pbkdf2_sha256$390000$...$...
MIETINKASSO_BACKOFFICE_SESSION_TTL_MINUTEN=480
# true (Default) verlangt HTTPS für das Session-Cookie - so soll es hinter
# dem Caddy-Reverse-Proxy laufen. Nur für lokale Tests ohne TLS auf false.
MIETINKASSO_BACKOFFICE_COOKIE_SECURE=true

# -- Read-Only-API (/v1/*, siehe api/app.py) -----------------------------
# Ohne diesen Token bleiben /v1/*-Endpunkte mit 503 geschlossen
# ("closed by default"). Falls nicht gebraucht: einfach weglassen.
# MIETINKASSO_API_TOKEN=<langer-zufaelliger-token>

# -- Sicherheitsstandards, NICHT ohne ausdrückliche Freigabe ändern ------
MIETINKASSO_SEND_ENABLED=false
MIETINKASSO_BANK_STAND_MAX_AGE_DAYS=2
MIETINKASSO_MAHN_STUFE1_TAGE_NACH_FAELLIGKEIT=7
MIETINKASSO_MAHN_STUFE2_MINDESTTAGE_NACH_STUFE1=14
